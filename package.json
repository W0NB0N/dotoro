{
  "name": "dotoro",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @dotoro/web dev",
    "build": "pnpm --filter @dotoro/web build",
    "preview": "pnpm --filter @dotoro/web preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "assets": "node tools/assets/convert.mjs",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
